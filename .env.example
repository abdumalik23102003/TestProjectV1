APP_NAME="Kutubxona boti"
# Production'da: APP_ENV=production, APP_DEBUG=false va TELEGRAM_WEBHOOK_SECRET majburiy
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=telegram_library_bot
DB_USERNAME=sail
DB_PASSWORD=password

QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=array
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=${APP_URL}/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=

APP_MAX_FILE_SIZE_MB=20
TEACHER_STORAGE_QUOTA_GB=5
MAX_UPLOADS_PER_DAY=100
SIGNED_URL_EXPIRY_MINUTES=10
WIZARD_SESSION_TIMEOUT=15
