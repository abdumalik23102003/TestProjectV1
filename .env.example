APP_NAME="Kutubxona boti"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=telegram_library_bot
DB_USERNAME=sail
DB_PASSWORD=password

QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=array
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=${APP_URL}/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_MODE=remote
TELEGRAM_DOWNLOAD_LIMIT_MB=20
TELEGRAM_SEND_LIMIT_MB=50
ADMIN_TELEGRAM_IDS=

APP_MAX_FILE_SIZE_MB=20
TEACHER_STORAGE_QUOTA_GB=5
MAX_UPLOADS_PER_DAY=100
SIGNED_URL_EXPIRY_MINUTES=10
WIZARD_SESSION_TIMEOUT=15
APP_ALLOWED_DOCUMENT_EXTENSIONS=pdf,epub,doc,docx,txt,rtf,ppt,pptx
APP_ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
APP_ALLOWED_AUDIO_EXTENSIONS=mp3,m4a
APP_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,mkv

MATERIALS_DISK=private_materials
MATERIALS_DISK_ROOT=/var/www/storage/private_materials
